{
  "extends": "@shape/typescript-config/base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ],
      "@spatial/*": [
        "./apps/spatial-web/src/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "apps/*/.next/**"
  ]
}
