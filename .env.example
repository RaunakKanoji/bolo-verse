# Browser-safe: application origin, without a trailing path.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Server-only origins. Root dev/start supplies these for the two local apps.
# Production: set SPATIAL_WEB_ORIGIN on web and WEB_INTERNAL_ORIGIN on spatial.
SPATIAL_WEB_ORIGIN=http://127.0.0.1:3001
WEB_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Copy the publishable key for the matching Clerk development/production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server only. Missing integrations remain visibly unconfigured.
CLERK_SECRET_KEY=
# Optional Clerk PEM public key for networkless v1 session verification; otherwise JWKS is used.
CLERK_JWT_KEY=
# Reserved for a future verified webhook path; not required by the XR studio.
CLERK_WEBHOOK_SIGNING_SECRET=
# Neon PostgreSQL connection URL. Never expose either URL to a browser.
DATABASE_URL=
# Optional; explicitly falls back to DATABASE_URL when empty.
DATABASE_MIGRATION_URL=

# Select object storage explicitly. R2 remains supported; local-s3 uses Docker.
STORAGE_PROVIDER=r2
# Local SeaweedFS setup writes generated credentials into ignored .env.local.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional private Cloudflare R2 bucket and scoped S3-compatible credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Select model/speaker IDs only after checking current Sarvam documentation.
# XR speech adapters call Sarvam; entering values does not verify a live connection.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER_EN=
SARVAM_TTS_SPEAKER_HI=
SARVAM_TTS_SPEAKER_KN=

# Select a currently supported Gemini structured-output model for the XR assistant.
GEMINI_API_KEY=
GEMINI_MODEL=
# Separate image model: gemini-3.1-flash-image, gemini-3-pro-image or gemini-2.5-flash-image.
# Requires private R2 + database + Clerk; configured does not mean live verified.
GEMINI_IMAGE_MODEL=

# Shotstack video rendering. Keep the key server-only; use the matching key for this environment.
# sandbox maps to Shotstack stage, production maps to v1. Configuration is not live verification.
# Rendering also needs Clerk, Neon, private R2 and ENABLE_EXTERNAL_EDITOR=true.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=

# Demo is local-only and is rejected when Vercel deployment markers are present.
# Demo enables a clearly labeled local text assistant; it never substitutes for auth.
APP_MODE=live
ENABLE_EXTERNAL_EDITOR=false
ENABLE_BACKGROUND_REMOVAL=false
# WebXR is detected by the browser; immersive AR remains gated off for this scene.
# Comma-separated exact HTTP(S) origins; empty falls back to NEXT_PUBLIC_APP_URL.
# Include the exact origin used in your browser, e.g. http://127.0.0.1:3000.
ALLOWED_ORIGINS=
# Retention policy target; deletion processing is not implemented yet.
COMMAND_LOG_RETENTION_DAYS=7

# Offline synthetic seed commands only; never needed in a Vercel runtime.
# The public /demo snapshot needs no Clerk, database, storage or provider credentials.
DEMO_SEED_ENABLED=false
DEMO_WORKSPACE_SLUG=shape-xr-demo
DEMO_REFERENCE_DATE=2026-11-13
