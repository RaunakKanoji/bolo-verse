# Frontend env (safe to expose: these end up in the browser bundle).
# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional. Defaults to $VITE_SUPABASE_URL/functions/v1 when empty.
# https://YOUR-PROJECT-REF.functions.supabase.co also works.
VITE_FUNCTIONS_URL=

# NEVER put SARVAM_API_KEY / GEMINI_API_KEY / SUPABASE_SERVICE_ROLE_KEY here.
# Those are Edge Function secrets: see supabase/functions/.env.example and README.
