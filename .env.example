# Browser-safe: application origin, without a trailing path.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Copy the publishable key for the matching Clerk development/production instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Server only. Missing integrations remain visibly unconfigured in M0.
CLERK_SECRET_KEY=
# Reserved for a future verified webhook path; not required by M0.
CLERK_WEBHOOK_SIGNING_SECRET=
# Neon PostgreSQL connection URL. Never expose either URL to a browser.
DATABASE_URL=
# Optional; explicitly falls back to DATABASE_URL when empty.
DATABASE_MIGRATION_URL=

# Private Cloudflare R2 bucket and scoped S3-compatible credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Select model/speaker IDs only after checking current Sarvam documentation.
# M0 defines contracts only; entering values does not verify a live connection.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER_EN=
SARVAM_TTS_SPEAKER_HI=
SARVAM_TTS_SPEAKER_KN=

# Select a supported structured-output model when implementing M2.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional future external editor. Environment: sandbox or production.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=

# Demo is local-only and is rejected when Vercel deployment markers are present.
# M0 does not implement fake auth or fake live provider successes in either mode.
APP_MODE=live
ENABLE_EXTERNAL_EDITOR=false
ENABLE_BACKGROUND_REMOVAL=false
ENABLE_WEBXR=false
# Comma-separated exact HTTP(S) origins; empty falls back to NEXT_PUBLIC_APP_URL.
ALLOWED_ORIGINS=
# Retention policy target; deletion processing is not implemented in M0.
COMMAND_LOG_RETENTION_DAYS=7
