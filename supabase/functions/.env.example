# Edge Function secrets. Copy to supabase/functions/.env (git-ignored), fill in, then:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into hosted Edge Functions, so you do not set them yourself.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated allowed browser origins, e.g.
# https://boloverse.vercel.app,http://localhost:5173
# Empty = allow any origin (dev only; set this before the demo).
ALLOWED_ORIGINS=
