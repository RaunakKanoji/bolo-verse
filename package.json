{
  "name": "shape-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-xr.mjs && next dev",
    "build": "node scripts/prepare-xr.mjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "format": "prettier --write src/xr src/features/projects src/features/workspace src/features/playground",
    "format:check": "prettier --check src/xr src/features/projects src/features/workspace src/features/playground",
    "xr:prepare": "node scripts/prepare-xr.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "contracts:generate": "node --import tsx scripts/generate-contracts.ts",
    "contracts:check": "node --import tsx scripts/generate-contracts.ts --check",
    "contracts:test:swift": "node --import tsx scripts/test-swift-contracts.ts",
    "native:sync": "node scripts/sync-native-contracts.mjs",
    "native:check": "node scripts/sync-native-contracts.mjs --check",
    "native:test": "swift test --package-path apps/visionos/ShapeStudioCore",
    "check": "turbo run build",
    "env:check": "node --conditions=react-server --import tsx scripts/check-environment.ts",
    "workspace:graph": "turbo run build --dry=json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@clerk/backend": "3.27.0",
    "@clerk/nextjs": "7.9.25",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.107.1",
    "aframe": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "three-bmfont-text": "github:dmarcos/three-bmfont-text#c3eec235b9188aa0d8ed949101236e6d5fccf071",
    "ws": "8.22.2",
    "zod": "4.6.7",
    "zustand": "5.1.0",
    "@shape/scene-schema": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@shape/typescript-config": "workspace:*",
    "@shape/eslint-config": "workspace:*",
    "turbo": "2.11.11"
  },
  "type": "module",
  "packageManager": "pnpm@11.12.0"
}
